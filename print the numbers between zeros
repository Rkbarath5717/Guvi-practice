import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int n = scn.nextInt();
        int arr[]=new int[n];
        for(int i=0;i<n;i++){
            arr[i]=scn.nextInt();
        }
        int firstZero=-1;
        int secondZero=-1;
        for(int i=0;i<n;i++){
            if(arr[i]==0){
                if(firstZero==-1){
                    firstZero=i;
                }
                else{
                    secondZero=i;
                    break;
                }
            }
        }
        if(firstZero==-1 || secondZero==-1){
            System.out.print("-1");
            return;
        }
        if(secondZero - firstZero == 1){
            System.out.print("-1");
            return;
        }
            for(int i=firstZero+1;i<secondZero;i++){
                System.out.print(arr[i]+" ");
            }
        }
    }
