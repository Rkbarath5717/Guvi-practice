import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int n=scn.nextInt();
        int m=scn.nextInt();
        int power=n*m;
        int root=(int)Math.sqrt(power);
        if(root*root == power){
            System.out.print("yes");
        }
        else{
            System.out.print("no");
        }
    }
}
