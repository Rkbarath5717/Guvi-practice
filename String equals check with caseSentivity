import java.util.*;
public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        String s1=scn.next();
        String s2=scn.next();
        if(s1.length() != s2.length()){
            System.out.print("no");
            return;
        }
        for(int i=0;i<s1.length();i++){
            if(s1.charAt(i) != s2.charAt(i)){
                System.out.print("no");
                return;
            }
        }
        System.out.print("yes");
    }
}
