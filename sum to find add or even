import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        int N=scn.nextInt();
        int M=scn.nextInt();
        int sum = N+M;
        if(sum%2==0){
            System.out.print("even");
        }
        else{
            System.out.print("odd");
        }
    }
}
